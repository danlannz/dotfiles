#!/usr/bin/env bash
alias xargs='xargs '
alias ls='gls -ap --color=auto'
alias ccat='pygmentize -g'
# Explicit user actions only; never terminate Finder to refresh its preferences.
alias showHiddenFiles='defaults write com.apple.finder AppleShowAllFiles -bool true && printf "Hidden-file preference updated; reopen Finder manually if needed.\n"'
alias hideHiddenFiles='defaults write com.apple.finder AppleShowAllFiles -bool false && printf "Hidden-file preference updated; reopen Finder manually if needed.\n"'

# Applications
alias ios='open /Applications/Xcode.app/Contents/Developer/Applications/Simulator.app'
alias typora="open -a typora"


alias gf="git fuzzy"