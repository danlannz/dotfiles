#!/bin/sh

log()   { STEP="$*"; echo "--> $*"; }
logk()  { STEP="";   echo "OK"; }

# Preserve the repo's shell configuration and keep installation non-interactive.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [ ! -d "$ZSH" ]; then
  log "Installing ohmyzsh:"
  OMZ_INSTALLER="$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" || exit 1
  sh -c "$OMZ_INSTALLER" "" --unattended --keep-zshrc || exit 1
  logk
fi

# Repair missing plugins after an interrupted run without replacing existing ones.
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"
mkdir -p "$ZSH_CUSTOM/plugins" || exit 1
for repository in \
  https://github.com/joel-porquet/zsh-dircolors-solarized \
  https://github.com/zsh-users/zsh-autosuggestions \
  https://github.com/zsh-users/zsh-syntax-highlighting
do
  plugin_dir="$ZSH_CUSTOM/plugins/${repository##*/}"
  if [ ! -d "$plugin_dir" ]; then
    log "Installing ${repository##*/}:"
    git clone --recursive "$repository" "$plugin_dir" || exit 1
    logk
  fi
done

# Install fonts
if [ ! -f "$HOME/Library/Fonts/Meslo LG S Regular for Powerline.ttf" ]; then
  log "Installing Font: Meslo LG S Regular for Powerline"
  wget -nc -P "$HOME/Library/Fonts" https://github.com/powerline/fonts/raw/master/Meslo%20Slashed/Meslo%20LG%20S%20Regular%20for%20Powerline.ttf
  logk
fi
if [ ! -f "$HOME/Library/Fonts/Meslo LG M Regular for Powerline.ttf" ]; then
  log "Installing Font: Meslo LG M Regular for Powerline"
  wget -nc -P "$HOME/Library/Fonts" https://github.com/powerline/fonts/raw/master/Meslo%20Slashed/Meslo%20LG%20M%20Regular%20for%20Powerline.ttf
  logk
fi

# Restore Mackup configs
mackup restore

# Install latest node LTS via NVM
export NVM_DIR="$HOME/.nvm"
NVM_SCRIPT="$(brew --prefix nvm)/nvm.sh"
[ -s "$NVM_SCRIPT" ] && . "$NVM_SCRIPT" # Intel and Apple Silicon Homebrew
nvm install --lts --latest-npm || exit 1
nvm use --lts || exit 1

# Install Bun if needed, then link agent config, restore missing skills, and validate.
if ! command -v bun >/dev/null 2>&1; then
  brew install oven-sh/bun/bun || exit 1
fi
bun "$HOME/.dotfiles/agents/setup.ts" || exit 1
