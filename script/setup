#!/bin/bash
set -euo pipefail

# Deployment is owned by the explicit native declarations, never a home-directory glob.
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --dry-run ]; }; then
  echo "Usage: $0 [--dry-run]" >&2
  exit 2
fi
command -v mise >/dev/null 2>&1 || {
  echo "mise is required; run bootstrap.sh or install mise before deployment." >&2
  exit 1
}

# Trust only this checkout's reviewed declaration, not a broad directory tree.
mise trust "$ROOT/mise.toml"
if [ "$#" -eq 1 ]; then
  exec mise -C "$ROOT" dot apply --dry-run
fi
# Native self-configuration is applied before ordinary files. Check conflicts
# first so a real .zshrc/.Brewfile does not leave a new global config behind.
mise -C "$ROOT" dot apply --dry-run
exec mise -C "$ROOT" dot apply
